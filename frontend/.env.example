# Base URL of the backend API (no trailing slash).
# Local dev (either mode): http://localhost:5000/api
# Production build: your deployed public backend URL, e.g. https://your-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Shows/hides the hidden admin entry point in the UI.
# true  -> ONLY for your local machine when you're updating content.
# false -> the value used for the production build you deploy to GitHub Pages.
VITE_ENABLE_ADMIN=false

# Optional: enable contact form sending to backend API if you want the UI to use a custom route.
# Leave as-is unless you change the backend route path or need a different endpoint for tests.
VITE_CONTACT_ENDPOINT=/api/contact

NODE_ENV=production
