# ---- Server ----
PORT=5000

# Comma-separated list of origins allowed to call this API.
# Include your local dev frontend AND your deployed GitHub Pages URL.
CLIENT_ORIGIN=http://localhost:5173,https://yourusername.github.io

# ---- Database (MongoDB Atlas free tier — same URI used by BOTH the public
#      deployment and your local admin instance, so admin edits show up live) ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio

# ---- Admin mode ----
# Set to "true" ONLY on your local machine. Leave "false" (or unset) on any
# publicly deployed instance — this is what hides/disables the write API and
# the whole admin dashboard in production.
ENABLE_ADMIN=false

# The PIN you type into the hidden admin login screen. Change this.
ADMIN_PIN=changeme123

# Long random string used to sign admin session tokens.
JWT_SECRET=replace_with_a_long_random_string

# ---- Cloudinary (image hosting for project/cert/profile images) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- AI recruiter Q&A ----
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Contact form email delivery ----
# SMTP settings for sending messages from the Contact Us section.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# Optional: if profile.email is empty, this fallback email receives contact form submissions.
CONTACT_TO_EMAIL=your_email@gmail.com

# The profile.email field is already supported; keep CONTACT_TO_EMAIL as a fallback.
# Example Gmail setup:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_FROM=your_email@gmail.com
